#!/bin/bash

# ClamAV Complete System Scan Script
# Official ClamAV Website: https://www.clamav.net/
# ClamAV is licensed under GPLv2
# This is a helper script for ClamAV, not an official product

# Save as: full-system-scan.sh

# Colors for output/ change if you like 
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Log file to check previous scans
LOG_FILE="/var/log/clamav-full-scan-$(date +%Y%m%d-%H%M%S).log"
SCAN_REPORT="/var/log/clamav-scan-report-$(date +%Y%m%d-%H%M%S).txt"

# The progression bar - FIXED FOR CACHY OS
progress_bar() {
    local current=$1  
    local len=$2
    
    # FIX: Clean inputs and ensure they're valid numbers
    current="${current//[^0-9]/}"  # Remove any non-digit characters
    len="${len//[^0-9]/}"  # Remove any non-digit characters
    
    # Set defaults if empty
    if [[ -z "$current" ]] || [[ ! "$current" =~ ^[0-9]+$ ]]; then
        current=0
    fi
    
    if [[ -z "$len" ]] || [[ ! "$len" =~ ^[0-9]+$ ]] || [[ "$len" -eq 0 ]]; then
        len=1  # Prevent division by zero
    fi
    
    local bar_char='|'
    local empty_char=' '
    local length=50
    
    # Safe arithmetic
    local perc_done=$((current * 100 / len))
    if [[ "$perc_done" -gt 100 ]]; then
        perc_done=100
    fi
    
    local num_bars=$((perc_done * length / 100))
   
    local i 
    local s='['
    for ((i = 0; i < num_bars; i++)); do
        s+=$bar_char
    done 
    for ((i = num_bars; i < length; i++)); do
        s+=$empty_char
    done
    s+=']'
    
    # Use printf instead of echo -ne for cleaner output
    printf "\r%s %s/%s (%s%%)" "$s" "$current" "$len" "$perc_done"
}

# Check if running as root /please review code if you unsure of running root privelidges
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error: This script must be run as root (use sudo)${NC}"
    exit 1
fi

# Function to log messages 
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

# Function to handle errors
error_exit() {
    echo -e "${RED}Error: $1${NC}" | tee -a "$LOG_FILE"
    exit 1
}

# Header
echo "==========================================" | tee -a "$LOG_FILE"
echo "ClamAV Full System Scan Started" | tee -a "$LOG_FILE"
echo "Date: $(date)" | tee -a "$LOG_FILE"
echo "Log: $LOG_FILE" | tee -a "$LOG_FILE"
echo "Report: $SCAN_REPORT" | tee -a "$LOG_FILE"
echo "==========================================" | tee -a "$LOG_FILE"

# Step 1: Check if ClamAV is installed
log_message "Checking ClamAV installation..."
if ! command -v clamscan &> /dev/null; then
    error_exit "ClamAV is not installed. Install with: sudo apt install clamav clamav-daemon"
fi

# Step 2: Handle freshclam service
log_message "Checking freshclam service status..."
FRESHCLAM_RUNNING=false

if systemctl is-active --quiet clamav-freshclam; then
    FRESHCLAM_RUNNING=true
    log_message "Stopping freshclam service to avoid conflicts..."
    sudo systemctl stop clamav-freshclam
    sleep 2
fi

# Step 3: Update virus definitions
log_message "Updating virus definitions..."
if ! freshclam --verbose; then
    echo -e "${YELLOW}Warning: Failed to update virus definitions, continuing with existing database${NC}" | tee -a "$LOG_FILE"
    # Check database age
    DB_DIR="/var/lib/clamav"
    if [ -f "$DB_DIR/main.cvd" ]; then
        DB_AGE=$(( ($(date +%s) - $(stat -c %Y "$DB_DIR/main.cvd")) / 86400 ))
        if [ "$DB_AGE" -gt 7 ]; then
            echo -e "${YELLOW}Warning: Virus database is $DB_AGE days old${NC}" | tee -a "$LOG_FILE"
        fi
    fi
else
    log_message "Virus definitions updated successfully"
fi

# Step 4: Restart freshclam service if it was running
if [ "$FRESHCLAM_RUNNING" = true ]; then
    log_message "Restarting freshclam service..."
    sudo systemctl start clamav-freshclam
fi

# Step 5: Define excluded directories (to avoid unnecessary scanning and errors)
EXCLUDE_DIRS="--exclude-dir=/proc --exclude-dir=/sys --exclude-dir=/dev --exclude-dir=/snap --exclude-dir=/run --exclude-dir=/tmp"

# Step 6: Start the full system scan with progress bar
log_message "Starting full system scan..."
echo -e "${YELLOW}This may take several hours depending on your system size...${NC}"
echo -e "${YELLOW}Do not interrupt the scan!${NC}"

echo ""
echo -e "${GREEN}Scan Progress:${NC}"

# Initialize variables for progress tracking
FILE_COUNT=0
SCANNED_COUNT=0

# Count total files first (this gives us the total for progress bar)
echo "Counting files on system (for progress bar)..."
FILE_COUNT=$(find / -type f \
    ! -path "/proc/*" \
    ! -path "/sys/*" \
    ! -path "/dev/*" \
    ! -path "/snap/*" \
    ! -path "/run/*" \
    ! -path "/tmp/*" \
    2>/dev/null | wc -l)

if [ "$FILE_COUNT" -eq 0 ]; then
    echo -e "${YELLOW}Could not count files, running scan without progress bar${NC}"
    # Run the scan with detailed options
    clamscan --verbose \
        --recursive \
        --infected \
        --remove \
        --detect-pua \
        --scan-archive=yes \
        --max-filesize=512M \
        --max-scansize=512M \
        $EXCLUDE_DIRS \
        / \
        > "$SCAN_REPORT" 2>&1
    SCAN_EXIT=$?
else
    echo "Total files to scan: $FILE_COUNT"
    echo ""
    
    # Show initial progress bar
    progress_bar 0 "$FILE_COUNT"
    
    # Run scan and track progress - FIXED PIPELINE
    # Using a subshell to handle the pipeline properly
    (
    clamscan --verbose \
        --recursive \
        --infected \
        --remove \
        --detect-pua \
        --scan-archive=yes \
        --max-filesize=512M \
        --max-scansize=512M \
        $EXCLUDE_DIRS \
        / 2>&1 
    ) | tee "$SCAN_REPORT" | while IFS= read -r line; do
        
        # Update progress bar when a file is scanned
        if [[ "$line" == Scanning* ]]; then
            SCANNED_COUNT=$((SCANNED_COUNT + 1))
            # Update progress bar every 100 files to avoid slowing down
            if [ $((SCANNED_COUNT % 100)) -eq 0 ] || [ "$SCANNED_COUNT" -eq "$FILE_COUNT" ]; then
                # Pass clean values to progress_bar
                clean_count="${SCANNED_COUNT//[^0-9]/}"
                clean_total="${FILE_COUNT//[^0-9]/}"
                progress_bar "$clean_count" "$clean_total"
            fi
        fi
        
        # Show virus alerts immediately
        if [[ "$line" == *FOUND ]]; then
            printf "\n"  # New line for alert
            echo -e "${RED}$line${NC}"
            # Show progress bar again after alert
            clean_count="${SCANNED_COUNT//[^0-9]/}"
            clean_total="${FILE_COUNT//[^0-9]/}"
            progress_bar "$clean_count" "$clean_total"
        fi
    done
    
    # Capture the exit status - FIXED: Get it from the subshell
    SCAN_EXIT=${PIPESTATUS[0]}
    
    # Final progress update
    clean_total="${FILE_COUNT//[^0-9]/}"
    progress_bar "$clean_total" "$clean_total"
    printf "\n"
fi

# Step 7: Process results
echo ""
echo "==========================================" | tee -a "$LOG_FILE"
log_message "Scan completed with exit code: $SCAN_EXIT"

# Interpret results
case $SCAN_EXIT in
    0)
        echo -e "${GREEN}No viruses found!${NC}" | tee -a "$LOG_FILE"
        ;;
    1)
        echo -e "${YELLOW}Virus(es) found and removed!${NC}" | tee -a "$LOG_FILE"
        ;;
    2)
        echo -e "${YELLOW}Some files could not be scanned (check logs)${NC}" | tee -a "$LOG_FILE"
        ;;
    *)
        echo -e "${RED}Scan failed with unknown error (code: $SCAN_EXIT)${NC}" | tee -a "$LOG_FILE"
        ;;
esac

# Show summary
log_message "Scan report saved to: $SCAN_REPORT"
log_message "Full log saved to: $LOG_FILE"

# Display quick summary from report
if [ -f "$SCAN_REPORT" ]; then
    echo "------------------------------------------" | tee -a "$LOG_FILE"
    echo "SCAN SUMMARY:" | tee -a "$LOG_FILE"
    grep -E "(Infected files|Scanned files|Data scanned|Time:|Known viruses|Engine version)" "$SCAN_REPORT" | head -10 | tee -a "$LOG_FILE"
fi

log_message "Full system scan completed!"
echo "==========================================" | tee -a "$LOG_FILE"
